project HelloProgram {
    arch = ["current"];
    version = "latest_stable";
    format = "exe";
    entry = main;

    ruleset {
        decline_vulpine_style_decl = false;
        allow_c_style_decl = false;
    }
}

fn math(x: int, y: int): int {
    return x + y;
}

fn changeVal(x: int): nullptr {
    x += 6;
}

fn looper(a: int): nullptr {
    if (a < 10) {
        a += 1;
        looper(a);
    }
}

fn main(): uint {
    let x: int = 6;
    let y: int = 6;

    let z: uint = math(x, y): uint; 

    changeVal(z);

    let w: wauto = @z;

    let a: uint = ^w; 

    let b: int = 0;
    looper(b);

    return b:uint;
}