project HelloProgram {
    arch = ["current"];
    version = "latest_stable";
    format = "exe";
    entry = main;

    ruleset {
        decline_vulpine_style_decl = false;
        allow_c_style_decl = false;
    }
}

fn add(a: int, b: int): int {
    return a + b;
}

fn main(): int {

    let x: int[] = [1, 2];

    return x[0];
}