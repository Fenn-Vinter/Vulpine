project HelloProgram {
    arch = ["current"];
    version = "latest_stable";
    format = "exe";
    entry = main;

    ruleset {
        decline_vulpine_style_decl = false;
        allow_c_style_decl = false;
    }
}

fn main(): uint {
    let x: int = 5;
    let y: x = 3;

    let z: uint = (x + y):uint;

    return z + 12;
}
